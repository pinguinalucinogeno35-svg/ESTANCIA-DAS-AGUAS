# Copie para .env.local e preencha. Nunca coloque valores reais neste arquivo.

# Supabase (Project Settings, API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta: só no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=

# Hospedin (API v3). Deixe em branco enquanto a integração não estiver ligada.
HOSPEDIN_ACCOUNT_ID=
HOSPEDIN_CLIENT_ID=
HOSPEDIN_CLIENT_SECRET=
